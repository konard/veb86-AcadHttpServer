<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the same HTTP layer as the AutoCAD plugin, but in a console process (no AutoCAD needed). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AutoCADHttp\Http\*.cs" Link="Http\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
