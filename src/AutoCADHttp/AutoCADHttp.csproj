<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoCAD 2021 plugin: .NET Framework 4.8, x64.

    AutoCAD API assemblies (AcMgd.dll, AcDbMgd.dll, AcCoreMgd.dll) are resolved like this:
      1. If AutoCAD 2021 is installed in $(AcadDir) - the DLLs from the installation are used.
         Override the path if needed:  dotnet build -p:AcadDir="D:\Autodesk\AutoCAD 2021"
      2. Otherwise the official Autodesk NuGet packages for AutoCAD 2021
         (AutoCAD.NET / AutoCAD.NET.Core / AutoCAD.NET.Model 24.0.0, "AutoCAD 2021 .Net API") are used.
         This allows building on CI / machines without AutoCAD.
         Force this mode (e.g. on CI) with:  dotnet build -p:UseInstalledAcad=false
    In both cases the AutoCAD DLLs are NOT copied to the output folder (Private=false / ExcludeAssets=runtime):
    AutoCAD loads its own copies at runtime.

    Version: local builds get 0.0.0; .github/workflows/build-release.yml passes -p:Version=0.0.<N>.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <OutputType>Library</OutputType>
    <AssemblyName>AutoCADHttp</AssemblyName>
    <RootNamespace>AutoCADHttp</RootNamespace>
    <Version>0.0.0</Version>
    <Product>AutoCAD HTTP Server</Product>
    <Description>Configurable local HTTP server running inside AutoCAD 2021</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2021</AcadDir>
    <UseInstalledAcad Condition="Exists('$(AcadDir)\acmgd.dll') And Exists('$(AcadDir)\acdbmgd.dll') And Exists('$(AcadDir)\accoremgd.dll')">true</UseInstalledAcad>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseInstalledAcad)' == 'true'">
    <Reference Include="AcMgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseInstalledAcad)' != 'true'">
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="24.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="ReportAcadReferences" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="high" Condition="'$(UseInstalledAcad)' == 'true'" Text="AutoCADHttp: using AutoCAD 2021 assemblies from '$(AcadDir)'" />
    <Message Importance="high" Condition="'$(UseInstalledAcad)' != 'true'" Text="AutoCADHttp: AutoCAD 2021 not found in '$(AcadDir)', using NuGet AutoCAD.NET 24.0.0 reference assemblies" />
  </Target>

  <!-- Fail with a clear message instead of a pile of CS0246 errors if the AutoCAD API assemblies were not resolved. -->
  <Target Name="CheckAcadReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_AcadApiReference Include="@(ReferencePath->'%(Filename)')" Condition="'%(Filename)' == 'AcMgd' Or '%(Filename)' == 'AcDbMgd' Or '%(Filename)' == 'AcCoreMgd'" />
    </ItemGroup>
    <Error Condition="'@(_AcadApiReference->Distinct()->Count())' != '3'" Text="AutoCADHttp: AutoCAD 2021 API assemblies (AcMgd.dll, AcDbMgd.dll, AcCoreMgd.dll) were not resolved (found: '@(_AcadApiReference)'). Install AutoCAD 2021 into '$(AcadDir)' or make sure the NuGet packages AutoCAD.NET / AutoCAD.NET.Core / AutoCAD.NET.Model 24.0.0 can be restored from nuget.org." />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AutoCADHttp.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
